# Shared Docker build context — used by API, worker, and web Dockerfiles.
# Do not exclude apps/api, apps/worker, pyproject.toml, or uv.lock here;
# the Python images COPY those paths explicitly.

# Git / editor
.git
.github
.cursor
**/.DS_Store

# Local env and secrets
.env
.env.*

# JS caches and installs (web image re-installs deps inside the container)
node_modules
**/.next
**/.turbo
**/node_modules
playwright-report
coverage

# Python local artifacts
.venv
**/__pycache__
**/*.pyc

# Heavy local data / ML artifacts
data
apps/ml-lab/artifacts

# Docs / misc
*.md
!apps/web/**/*.md
