# GridTrace environment configuration
# Copy to .env and adjust. Never commit real secrets.

# --- Database ---
DATABASE_URL=postgresql://gridtrace:gridtrace@localhost:5432/gridtrace
ASYNC_DATABASE_URL=postgresql+asyncpg://gridtrace:gridtrace@localhost:5432/gridtrace

# --- Background jobs (optional; APScheduler fallback when empty) ---
REDIS_URL=

# --- Security ---
JWT_SECRET=dev-only-insecure-change-me

# --- API server ---
# Port 8003 avoids conflicts with Docker services that commonly bind 8000.
API_HOST=0.0.0.0
API_PORT=8003

# --- Frontend (public, browser-exposed) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8003
NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
NEXT_PUBLIC_DEMO_MODE=false

# --- Object storage (falls back to local filesystem when empty) ---
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# --- ML artifacts & demo determinism ---
MODEL_ARTIFACT_PATH=./apps/ml-lab/artifacts
DEMO_SEED=42

# --- MOMENT TSFM inference (worker) ---
# 1. ./scripts/pip-install.sh
# 2. ./scripts/pip-install-ml.sh   (large download — torch + momentfm)
# 3. Set MOMENT_ENABLED=true
MOMENT_ENABLED=false
MOMENT_MODEL_NAME=AutonLab/MOMENT-1-large
MOMENT_CONTEXT_LENGTH=512
MOMENT_BATCH_SIZE=32
# MOMENT_DEVICE=cuda

# --- Amsterdam hybrid open-data (NED + local Parquet OLAP) ---
# Obtain a developer key at https://ned.nl/nl/api
NATIONAAL_ENERGIE_DASHBOARD_API_KEY=
DATA_RAW_PATH=./data/raw
DATA_PROCESSED_PATH=./data/processed
